#. translators: 1: constant name 2: constant explanation 3: wp-config.php docs URL
#: src/SecretsHelper.php:25
#, php-format
msgctxt "trusted-shops"
msgid ""
"Attention! The <em>%1$s</em> (%2$s) constant is missing. Trusted Shops Easy "
"Integration uses a derived key based on the <em>LOGGED_IN_KEY</em> constant "
"instead. This constant might change under certain circumstances. To prevent "
"data losses, please insert the following snippet within your <a "
"href=\"%3$s\" target=\"_blank\">wp-config.php</a> file:"
msgstr ""
"Attention! La constante <em>%1$s</em> (%2$s) est manquante. Trusted Shops "
"Easy Integration utilise une clé dérivée basée sur la constante "
"<em>LOGGED_IN_KEY</em> à la place. Cette constante peut changer dans "
"certaines circonstances. Pour éviter les pertes de données, veuillez insérer "
"l'extrait suivant dans votre fichier <a href=\"%3$s\" target=\"_blank\">wp-"
"config.php</a>:"

#: dist/blocks/trstd-login/index.js:1
msgid ""
"#trstd login - displayed in your storefront as soon as it is enabled in your "
"Trusted Shops settings."
msgstr "#trstd login - affiché dans votre boutique dès son activation dans vos paramètres Trusted Shops."

#: assets/blocks/trstd-login/block.json
msgctxt "block title"
msgid "#trstd login"
msgstr "#trstd login"

#: assets/blocks/trstd-login/block.json
msgctxt "block description"
msgid ""
"Places the Trusted Shops #trstd login element, e.g. next to the account or "
"cart icon within your header. Rendered only in case #trstd login is enabled "
"for the current channel."
msgstr "Place l'élément Trusted Shops #trstd login, par ex. à côté de l'icône du compte ou du panier dans votre en-tête. Affiché uniquement si #trstd login est activé pour le canal actuel."

#: assets/blocks/trstd-login/block.json
msgctxt "block keyword"
msgid "Trusted Shops"
msgstr "Trusted Shops"

#: assets/blocks/trstd-login/block.json
msgctxt "block keyword"
msgid "trstd"
msgstr "trstd"

#: assets/blocks/trstd-login/block.json
msgctxt "block keyword"
msgid "login"
msgstr "connexion"

#: assets/blocks/trstd-login/block.json
msgctxt "block keyword"
msgid "trusted"
msgstr "confiance"